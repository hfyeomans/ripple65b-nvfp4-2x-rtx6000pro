# Literal KEY=value settings. No shell expansion or surrounding quotes.
# Exported environment values take precedence. Never put credentials here.
# Copy to .env and edit; every setting is optional (defaults below).

# Host Hugging Face hub cache. Snapshots resolve below it via config/model-lock.json:
#   $HF_CACHE_ROOT/hub/models--ricursiveAI--Ripple-65B-Preview-NVFP4/snapshots/<MODEL_REVISION>
#   $HF_CACHE_ROOT/hub/models--ricursiveAI--Ripple-65B-Preview-DFlash2/snapshots/<DRAFT_REVISION>
# Set MODEL_SNAPSHOT_DIR / DRAFT_SNAPSHOT_DIR to absolute paths to serve other copies.
HF_CACHE_ROOT=/models_engrams/huggingface
# MODEL_REVISION=99eea4477a001a41b86914e41feb4b2ed86105e5
# MODEL_SNAPSHOT_DIR=/absolute/path/to/nvfp4/checkpoint
# DRAFT_REVISION=35609b3be3dd08a822b3ba1257c1ea5dd6f87632
# DRAFT_SNAPSHOT_DIR=/absolute/path/to/dflash2/draft

# Pinned SGLang image (same image the BF16 recipe qualified).
IMAGE=lmsysorg/sglang:v0.5.19@sha256:d6e7288627be8b02be88e4bba38e73f6d50e2826869f753c13a4c4385ab3eda9
CONTAINER_NAME=ripple65b-nvfp4-sglang-tp2
RUNTIME_VOLUME=ripple65b-nvfp4-runtime

# Exactly two host GPU IDs, in any order. Tensor parallel is fixed at 2.
# GPU list; TP_SIZE must equal its length and divide the model's 80 attention / 8 KV heads
# (valid: 1, 2, 4, 8). TP=1 serves the whole NVFP4 checkpoint on one 96 GB card (128–256K).
GPUS=0,1
TP_SIZE=2
HOST=0.0.0.0
PORT=30001
SERVED_MODEL_NAME=ripple-65b-nvfp4

# Per-request prompt + output token ceiling. NVFP4 weights free ~34 GiB/GPU versus BF16, so
# the measured KV pool at MEM_FRACTION_STATIC=0.78 holds ~700K compact tokens; the default
# keeps 128K, the vendor's qualified ceiling. See README "Memory" before raising it.
MAX_MODEL_LEN=131072
MEM_FRACTION_STATIC=0.78
ATTENTION_BACKEND=flashinfer
# bfloat16 (vendor parity, default) or fp8_e4m3 (long-context profile; real k/v scales kept).
KV_CACHE_DTYPE=bfloat16
MAX_RUNNING_REQUESTS=4

# DFlash2 speculative decoding (draft trained on 16K-token rows; window is fixed by training).
NUM_DRAFT_TOKENS=32
DRAFT_WINDOW_SIZE=16384
# SWA pool size as a fraction of the full pool. Unset = engine default (0.8). The 1M profile
# sets SWA_RATIO=0.02: SWA layers only ever need ~1024 tokens per request, so a large SWA pool
# is wasted memory that the full-attention pool needs instead.
# SWA_RATIO=0.02

# Extra SGLang CLI flags appended to the serve command (word-split).
# SERVE_EXTRA_ARGS=

MIN_GPU_FREE_MIB=88000
WAIT_TIMEOUT=1800
SMOKE_TIMEOUT=300
# no: stop on first failure and inspect logs. Set on-failure:3 after acceptance.
RESTART_POLICY=no

# Unset: the API is unauthenticated. Export SGLANG_API_KEY (never into .env) to
# require `Authorization: Bearer <key>` on every route except /health.
# SGLANG_API_KEY=
